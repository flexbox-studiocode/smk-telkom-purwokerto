generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum ContentStatus {
  draft
  published
}
enum BkkStatus {
  aktif
  ditutup
}
enum PpdbStatus {
  menunggu
  diproses
  diterima
  ditolak
}
enum EventCategory {
  kegiatan
  akademik
  lomba
  karier
  lainnya
  awal_pkl             @map("awal-pkl")
  penilaian_siswa      @map("penilaian-siswa")
  libur_akhir_semester @map("libur-akhir-semester")
  cuti_bersama         @map("cuti-bersama")
  libur_tahun_pelajaran @map("libur-tahun-pelajaran")
  hari_pertama_sekolah @map("hari-pertama-sekolah")
  upacara_nasional     @map("upacara-nasional")
  hut_smk              @map("hut-smk")
  libur_ramadhan       @map("libur-ramadhan")
  perkiraan_kelulusan  @map("perkiraan-kelulusan")
}
enum SpmbKind {
  jadwal
  timeline
  skema
  persyaratan
  syarat
  statistik
}
enum AiFeature {
  stela
  nexttel
}
enum NexaCategory {
  sekolah
  instansi
}
enum AuthTokenPurpose {
  verify_email
  password_reset
}

model Admin {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @unique @map("user_id") @db.Char(36)
  nama      String   @db.VarChar(180)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("admins")
}

model User {
  id            String      @id @default(uuid()) @db.Char(36)
  email         String      @unique @db.VarChar(254)
  passwordHash  String      @map("password_hash") @db.VarChar(255)
  emailVerified DateTime?   @map("email_verified")
  role          String      @default("applicant") @db.VarChar(30)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  admin         Admin?
  applications  Ppdb[]
  draft         PpdbDraft?
  sessions      Session[]
  authTokens    AuthToken[]
  @@map("users")
}

model AuthToken {
  id        String          @id @default(uuid()) @db.Char(36)
  userId    String          @map("user_id") @db.Char(36)
  tokenHash String          @unique @map("token_hash") @db.Char(64)
  purpose   AuthTokenPurpose
  expiresAt DateTime        @map("expires_at")
  createdAt DateTime        @default(now()) @map("created_at")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model Session {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Berita {
  id        String        @id @default(uuid()) @db.Char(36)
  judul     String        @db.VarChar(255)
  slug      String        @unique @db.VarChar(255)
  ringkasan String?       @db.Text
  konten    String        @db.LongText
  gambarUrl String?       @map("gambar_url") @db.VarChar(2048)
  penulis   String?       @db.VarChar(180)
  status    ContentStatus @default(draft)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  slugAlias BeritaSlugAlias[]
  @@index([status, createdAt])
  @@map("berita")
}

// Pemetaan URL lama -> berita. Dipakai agar tautan berita yang sudah beredar
// (sebelum slug diberi kode unik) tetap dapat dibuka dan dialihkan ke URL baru.
model BeritaSlugAlias {
  id        String   @id @default(uuid()) @db.Char(36)
  beritaId  String   @map("berita_id") @db.Char(36)
  slug      String   @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  berita    Berita   @relation(fields: [beritaId], references: [id], onDelete: Cascade)
  @@index([beritaId])
  @@map("berita_slug_alias")
}

model Pengumuman {
  id        String        @id @default(uuid()) @db.Char(36)
  judul     String        @db.VarChar(255)
  slug      String        @unique @db.VarChar(255)
  ringkasan String?       @db.Text
  konten    String        @db.LongText
  gambarUrl String?       @map("gambar_url") @db.VarChar(2048)
  status    ContentStatus @default(draft)
  tanggal   DateTime?
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  @@index([status, createdAt])
  @@map("pengumuman")
}

model Prestasi {
  id           String        @id @default(uuid()) @db.Char(36)
  judul        String        @db.VarChar(255)
  slug         String        @unique @db.VarChar(255)
  kategori     String?       @db.VarChar(120)
  deskripsi    String        @db.Text
  gambarUrl    String?       @map("gambar_url") @db.VarChar(2048)
  instagramUrl String?       @map("instagram_url") @db.VarChar(2048)
  tingkat      String?       @db.VarChar(120)
  tanggal      DateTime?
  status       ContentStatus @default(draft)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  @@index([tanggal])
  @@index([status, tanggal])
  @@map("prestasi")
}

enum WordPressJobStatus {
  uploaded
  processing
  completed
  partially_completed
  failed
  cancelled
}

enum WordPressTargetType {
  berita
  pengumuman
  prestasi
  needs_review
}

enum WordPressReviewStatus {
  pending_review
  ready
  in_audit
  imported
  skipped
  failed
}

model WordPressImportJob {
  id                 String            @id @default(uuid()) @db.Char(36)
  originalFileName   String            @map("original_file_name") @db.VarChar(255)
  sourceChecksum     String            @map("source_checksum") @db.Char(64)
  fileSize           BigInt            @map("file_size")
  status             WordPressJobStatus @default(uploaded)
  totalSourceRecords Int               @default(0) @map("total_source_records")
  candidateCount     Int               @default(0) @map("candidate_count")
  beritaCount        Int               @default(0) @map("berita_count")
  pengumumanCount    Int               @default(0) @map("pengumuman_count")
  prestasiCount      Int               @default(0) @map("prestasi_count")
  reviewCount        Int               @default(0) @map("review_count")
  skippedCount       Int               @default(0) @map("skipped_count")
  failedCount        Int               @default(0) @map("failed_count")
  progress           Int               @default(0)
  processedRows      Int               @default(0) @map("processed_rows")
  errorSummary       String?           @map("error_summary") @db.Text
  createdBy          String?           @map("created_by") @db.Char(36)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  completedAt        DateTime?         @map("completed_at")
  items              WordPressArchiveItem[]
  @@unique([sourceChecksum], map: "wordpress_import_jobs_checksum_key")
  @@index([status, createdAt])
  @@index([createdBy, createdAt])
  @@map("wordpress_import_jobs")
}

model WordPressArchiveItem {
  id               String                @id @default(uuid()) @db.Char(36)
  jobId            String                @map("job_id") @db.Char(36)
  sourceChecksum   String                @map("source_checksum") @db.Char(64)
  wordpressId      BigInt                @map("wordpress_id")
  sourcePostType   String                @default("post") @map("source_post_type") @db.VarChar(64)
  sourcePostStatus String                @default("") @map("source_post_status") @db.VarChar(32)
  sourceSlug       String?               @map("source_slug") @db.VarChar(255)
  sourceUrl        String?               @map("source_url") @db.VarChar(2048)
  sourceDate       DateTime?             @map("source_date")
  sourceModified   DateTime?             @map("source_modified")
  targetType       WordPressTargetType   @default(needs_review) @map("target_type")
  title            String                @db.VarChar(255)
  slug             String                @db.VarChar(255)
  summary          String?               @db.Text
  content          String?               @db.LongText
  imageUrl         String?               @map("image_url") @db.VarChar(2048)
  metadata         Json?                 @map("metadata")
  reviewStatus     WordPressReviewStatus @default(pending_review) @map("review_status")
  reviewNotes      String?               @map("review_notes") @db.Text
  importStatus     String?               @map("import_status") @db.VarChar(32)
  importedToId     String?               @map("imported_to_id") @db.Char(36)
  importedAt       DateTime?             @map("imported_at")
  reviewedBy       String?               @map("reviewed_by") @db.Char(36)
  reviewedAt       DateTime?             @map("reviewed_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  job              WordPressImportJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  revisions        WordPressArchiveRevision[]
  @@unique([sourceChecksum, wordpressId])
  @@index([jobId, targetType])
  @@index([reviewStatus, targetType])
  @@index([targetType, sourceDate])
  @@index([title])
  @@map("wordpress_archive_items")
}

model WordPressArchiveRevision {
  id        String   @id @default(uuid()) @db.Char(36)
  itemId    String   @map("item_id") @db.Char(36)
  actorId   String?  @map("actor_id") @db.Char(36)
  action    String   @db.VarChar(48)
  changes   Json?
  createdAt DateTime @default(now()) @map("created_at")
  item      WordPressArchiveItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  @@index([itemId, createdAt])
  @@map("wordpress_archive_revisions")
}

// Jejak audit penghapusan batch SQL. Job dan arsipnya memang dihapus, jadi
// ringkasan ini disimpan terpisah agar admin masih bisa menelusuri asal konten
// CMS yang pernah dibuat dari batch tersebut. Tidak menyimpan data sensitif.
model WordPressArchiveDeletion {
  id                String   @id @default(uuid()) @db.Char(36)
  jobId             String   @map("job_id") @db.Char(36)
  originalFileName  String   @map("original_file_name") @db.VarChar(255)
  sourceChecksum    String   @map("source_checksum") @db.Char(64)
  jobStatus         String   @map("job_status") @db.VarChar(32)
  deletedItemCount  Int      @default(0) @map("deleted_item_count")
  importedItemCount Int      @default(0) @map("imported_item_count")
  detail            Json?
  deletedBy         String?  @map("deleted_by") @db.Char(36)
  createdAt         DateTime @default(now()) @map("created_at")
  @@index([createdAt])
  @@map("wordpress_archive_deletions")
}

model Bkk {
  id              String    @id @default(uuid()) @db.Char(36)
  perusahaan      String    @db.VarChar(255)
  posisi          String    @db.VarChar(255)
  deskripsi       String?   @db.Text
  lokasi          String?   @db.VarChar(255)
  tipePekerjaan   String?   @map("tipe_pekerjaan") @db.VarChar(100)
  deadline        DateTime?
  status          BkkStatus @default(aktif)
  linkPendaftaran String?   @map("link_pendaftaran") @db.VarChar(2048)
  logoUrl         String?   @map("logo_url") @db.VarChar(2048)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  @@index([status, deadline])
  @@map("bkk")
}

model Ppdb {
  id             String     @id @default(uuid()) @db.Char(36)
  userId         String?    @unique @map("auth_user_id") @db.Char(36)
  namaLengkap    String     @map("nama_lengkap") @db.VarChar(255)
  nisn           String?    @db.VarChar(30)
  nik            String?    @db.VarChar(30)
  asalSekolah    String     @map("asal_sekolah") @db.VarChar(255)
  tempatLahir    String?    @map("tempat_lahir") @db.VarChar(120)
  tanggalLahir   DateTime?  @map("tanggal_lahir")
  jenisKelamin   String?    @map("jenis_kelamin") @db.VarChar(30)
  agama          String?    @db.VarChar(50)
  tahunLulus     String?    @map("tahun_lulus") @db.VarChar(10)
  alamat         String?    @db.Text
  noHp           String?    @map("no_hp") @db.VarChar(30)
  email          String?    @db.VarChar(254)
  pilihanJurusan String     @map("pilihan_jurusan") @db.VarChar(120)
  nilaiRapor     Json?      @map("nilai_rapor")
  dokumenUrl     String?    @map("dokumen_url") @db.VarChar(2048)
  status         PpdbStatus @default(menunggu)
  catatanAdmin   String?    @map("catatan_admin") @db.Text
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  user           User?      @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([status, createdAt])
  @@map("ppdb")
}

model PpdbDraft {
  userId    String   @id @map("auth_user_id") @db.Char(36)
  biodata   Json     @default("{}")
  nilai     Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("ppdb_drafts")
}

model Event {
  id              String        @id @default(uuid()) @db.Char(36)
  judul           String        @db.VarChar(180)
  ringkasan       String        @default("") @db.VarChar(500)
  deskripsi       String        @db.Text
  kategori        EventCategory @default(kegiatan)
  tanggalMulai    DateTime      @map("tanggal_mulai") @db.Date
  waktuMulai      String?       @map("waktu_mulai") @db.VarChar(8)
  tanggalSelesai  DateTime?     @map("tanggal_selesai") @db.Date
  waktuSelesai    String?       @map("waktu_selesai") @db.VarChar(8)
  lokasi          String        @default("") @db.VarChar(240)
  penyelenggara   String        @default("") @db.VarChar(160)
  gambarUrl       String?       @map("gambar_url") @db.VarChar(2048)
  linkInformasi   String?       @map("link_informasi") @db.VarChar(2048)
  status          ContentStatus @default(draft)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  @@index([status, tanggalMulai])
  @@map("events")
}

model SpmbInformation {
  id                  String        @id @default(uuid()) @db.Char(36)
  jenis               SpmbKind
  judul               String        @db.VarChar(180)
  deskripsi           String        @db.Text
  urutan              Int           @default(1)
  tanggalMulai        DateTime?     @map("tanggal_mulai") @db.Date
  tanggalSelesai      DateTime?     @map("tanggal_selesai") @db.Date
  tanggalSeleksi      DateTime?     @map("tanggal_seleksi") @db.Date
  tanggalPengumuman   DateTime?     @map("tanggal_pengumuman") @db.Date
  ikon                String?       @db.VarChar(30)
  tautanUrl           String?       @map("tautan_url") @db.VarChar(2048)
  sumberUrl           String?       @map("sumber_url") @db.VarChar(2048)
  status              ContentStatus @default(draft)
  kuotaTotal          Int?          @map("kuota_total")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  @@index([jenis, status, urutan])
  @@map("spmb_information")
}

model SiteSettings {
  id           Boolean  @id @default(true)
  schoolName   String   @map("school_name") @db.VarChar(150)
  npsn         String   @db.Char(8)
  address      String   @db.VarChar(1000)
  phone        String   @db.VarChar(30)
  email        String   @db.VarChar(254)
  website      String   @db.VarChar(2048)
  logoUrl      String?  @map("logo_url") @db.VarChar(2048)
  academicYear String   @map("academic_year") @db.Char(9)
  spmbOpen     Boolean  @default(true) @map("spmb_open")
  newsPageSize Int      @map("news_page_size")
  revision     Int      @default(1)
  updatedAt    DateTime @updatedAt @map("updated_at")
  @@map("site_settings")
}

model AiDailyAttempt {
  feature  AiFeature
  day      DateTime  @db.Date
  attempts Int
  @@id([feature, day])
  @@map("ai_daily_attempts")
}

model SiteVisitor {
  visitorHash String   @map("visitor_hash") @db.VarChar(128)
  day         DateTime @db.Date
  createdAt   DateTime @default(now()) @map("created_at")
  @@id([visitorHash, day])
  @@map("site_visitors")
}

model NexaSession {
  id           String       @id @default(uuid()) @db.Char(36)
  tokenHash    String       @unique @map("token_hash") @db.Char(64)
  fullName     String       @map("full_name") @db.VarChar(100)
  phone        String       @db.VarChar(20)
  age          Int          @db.UnsignedTinyInt
  category     NexaCategory
  organization String?      @db.VarChar(100)
  expiresAt    DateTime     @map("expires_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  @@index([expiresAt])
  @@map("nexa_sessions")
}
